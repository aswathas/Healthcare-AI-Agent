# Clinical AI Configuration
# Copy to .env and fill in your own values. NEVER commit the real .env.

# API Keys & URLs
GOOGLE_API_KEY=your-key-here
QDRANT_API_KEY=your-key-here
QDRANT_URL=https://your-cluster.cloud.qdrant.io

# Pollution & Web Search
POLLUTION_API_KEY=your-key-here
EXA_API_KEY=your-key-here

# Gmail SMTP details (for medication reminders)
GMAIL_USER=your-email@example.com
GMAIL_APP_PASSWORD=your-app-password-here
RECIPIENT_EMAIL=recipient@example.com

# Twilio SMS
TWILIO_SID=your-sid-here
TWILIO_AUTH_TOKEN=your-auth-token-here
TWILIO_SMS_FROM=your-twilio-number
RECIPIENT_PHONE=+10000000000